# Copy to .env for local dev. In production these come from your secret store
# (e.g. GCP Secret Manager) and the deploy pipeline, never from a committed file.

# --- GitHub App (required) ---
GITHUB_APP_ID=123456
# PEM private key. One line with \n escapes, or paste real newlines.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Random string, >= 16 chars. Must match the App's webhook secret. The service
# refuses to start without it.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- LLM backend (pick ONE) ---
# A) Gemini API key — simplest, runs anywhere:
# GENAI_API_KEY=your-aistudio-key
# B) Vertex AI — no key, uses Application Default Credentials / the runtime SA:
GCP_PROJECT=your-gcp-project
VERTEX_LOCATION=us-central1

MODEL=gemini-2.5-flash
THINKING_BUDGET=2048          # 0 disables thinking (cheapest)
REQUEST_TIMEOUT=120           # seconds per model call

# --- Cost guard (strongly recommended) ---
# Comma-separated GitHub org logins allowed to use this App. Empty = every
# installation is served (and costs you model calls). Case-insensitive.
ALLOWED_ORGS=my-org,my-other-org

# --- Review behaviour ---
# PROMPT_FILE=prompt.md
# EXCLUDE_GLOBS=**/*.lock,**/*.min.js,dist/**,build/**,vendor/**,node_modules/**
# MAX_PATCH_CHARS=12000
# MAX_FILES=40
# MAX_FINDINGS=30
# REVIEW_COMMAND=/genai-review

# --- Monitoring (optional — no-op when SENTRY_DSN is empty) ---
# SENTRY_DSN=https://xxxx@oYYYY.ingest.us.sentry.io/ZZZZ
# ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
