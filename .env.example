# GitHub App
GITHUB_APP_ID=123456
# PEM private key. One line with \n escapes, or paste real newlines.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=change-me

# Vertex AI (Cloud Run runtime SA needs roles/aiplatform.user)
GCP_PROJECT=proyectos-david-y-angelica
VERTEX_LOCATION=us-central1
MODEL=gemini-2.5-flash
THINKING_BUDGET=2048

# Org-wide behaviour
# PROMPT_FILE=prompt.md
# EXCLUDE_GLOBS=**/*.lock,dist/**,build/**,node_modules/**
# MAX_PATCH_CHARS=12000
# MAX_FILES=40
# MAX_FINDINGS=30
# REVIEW_COMMAND=/genai-review
